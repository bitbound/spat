<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce publish target. Publish with:
    dotnet publish Spat/Spat.csproj -p:PublishProfile=clickonce -c Release

  Produces an installable ClickOnce application (setup.exe + .appref-ms deployment).
  Set SignManifests to true and provide a certificate once one is available; unsigned
  ClickOnce deployments will prompt the user with a SmartScreen warning.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <!-- The SDK defaults this off for .NET (Core) executables; the ClickOnce manifest targets
         (launcher + deployment manifest) only run when it is explicitly enabled. -->
    <GenerateManifests>true</GenerateManifests>
    <PublishDir>bin\Release\publish\clickonce\</PublishDir>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- ClickOnce identity / branding -->
    <AssemblyName>spat</AssemblyName>
    <ProductName>Spat</ProductName>
    <SuiteName>Spat</SuiteName>
    <ApplicationRevision>1</ApplicationRevision>
    <!-- A plain four-part version; wildcards are not supported by dotnet publish. The release
         workflow overrides both of these with the build's date-stamped version. -->
    <ApplicationVersion>1.0.0.1</ApplicationVersion>

    <!-- Where the deployment manifest is served from. Replace with the real update URL. -->
    <PublishUrl>https://example.com/spat/</PublishUrl>
    <InstallUrl>https://example.com/spat/</InstallUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <SignManifests>false</SignManifests>
  </PropertyGroup>
</Project>
