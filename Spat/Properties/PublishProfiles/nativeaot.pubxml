<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeAOT publish target. Publish with:
    dotnet publish Spat/Spat.csproj -p:PublishProfile=nativeaot -c Release

  Produces a single self-contained, ahead-of-time-compiled spat.exe (win-x64).
  Requires the NativeAOT toolchain (Visual Studio "Desktop development with C++"
  workload, or a dev container with clang/MSVC).
-->
<Project>
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\Release\publish\nativeaot\</PublishDir>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
