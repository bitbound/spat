<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spat.ViewModels"
             xmlns:conv="using:Spat.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700"
             x:Class="Spat.Views.AboutView"
             x:DataType="vm:AboutViewModel">

  <UserControl.Resources>
    <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="PathIcon.checking">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="PathIcon.upToDate">
      <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="PathIcon.failed">
      <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    </Style>
    <Style Selector="TextBlock.checking">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.upToDate">
      <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="20">
    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

      <TextBlock Classes="h1" Text="About Spat" />

      <Border Classes="Card">
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Text="Version:" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Row="0" Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="12"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" />
            <Button Classes="Primary VariantText Small"
                    Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding !IsCheckingForUpdates}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Check GitHub Releases for a newer version">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{Binding UpdateStatusIconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                          Classes.checking="{Binding IsCheckingForUpdates}"
                          Classes.upToDate="{Binding IsUpToDate}"
                          Classes.failed="{Binding HasUpdateCheckFailed}" />
                <TextBlock Text="{Binding UpdateStatusText}"
                           Classes.checking="{Binding IsCheckingForUpdates}"
                           Classes.upToDate="{Binding IsUpToDate}"
                           Classes.failed="{Binding HasUpdateCheckFailed}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Grid.Row="1" FontWeight="SemiBold" Margin="0,8,0,0" Text="Project:" />
          <HyperlinkButton Grid.Row="1" Grid.Column="1"
                           Classes="Small"
                           Margin="0,8,0,0"
                           Content="{Binding RepositoryUrl}"
                           Command="{Binding OpenUrlCommand}"
                           CommandParameter="{Binding RepositoryUrl}" />

          <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,8,0,0" Text="Issues:" />
          <HyperlinkButton Grid.Row="2" Grid.Column="1"
                           Classes="Small"
                           Margin="0,8,0,0"
                           Content="Report a bug or request a feature"
                           Command="{Binding OpenUrlCommand}"
                           CommandParameter="{Binding IssuesUrl}" />

          <TextBlock Grid.Row="3" FontWeight="SemiBold" Margin="0,8,0,0" Text="License:" />
          <HyperlinkButton Grid.Row="3" Grid.Column="1"
                           Classes="Small"
                           Margin="0,8,0,0"
                           Content="GPL-3.0"
                           Command="{Binding OpenUrlCommand}"
                           CommandParameter="{Binding LicenseUrl}" />
        </Grid>
      </Border>

      <Border Classes="Card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Open-source libraries" />

          <ItemsControl ItemsSource="{Binding Libraries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryLink">
                <Grid ColumnDefinitions="220,Auto,*" Margin="0,4">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <HyperlinkButton Grid.Column="1"
                                   Classes="Small"
                                   Content="Source"
                                   Command="{Binding $parent[ItemsControl].((vm:AboutViewModel)DataContext).OpenUrlCommand}"
                                   CommandParameter="{Binding SourceUrl}" />
                  <HyperlinkButton Grid.Column="2"
                                   Classes="Small"
                                   Content="License"
                                   Command="{Binding $parent[ItemsControl].((vm:AboutViewModel)DataContext).OpenUrlCommand}"
                                   CommandParameter="{Binding LicenseUrl}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
