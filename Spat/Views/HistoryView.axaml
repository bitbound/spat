<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spat.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Spat.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <UserControl.Styles>
    <Style Selector="Button.ScrollToTop">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="Button.ScrollToTop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <Style Selector="Button.ScrollToTop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" MaxWidth="820" HorizontalAlignment="Stretch" Margin="20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="History" VerticalAlignment="Center" />
        <Button Content="Delete selected"
                Classes="Error VariantText Small"
                Command="{Binding DeleteCommand}"
                IsEnabled="{Binding CanDelete}" />
        <Button Content="Clear all"
                Classes="Error VariantText Small"
                Command="{Binding ClearCommand}"
                IsEnabled="{Binding HasEntries}" />
      </StackPanel>

      <Button Grid.Column="1"
              Classes="ScrollToTop"
              Click="OnScrollToTopClicked"
              IsVisible="{Binding HasEntries}"
              ToolTip.Tip="Scroll to top">
        <PathIcon Data="{StaticResource arrow_up_circle_regular}" Width="28" Height="28" />
      </Button>
    </Grid>

    <TextBlock Grid.Row="1"
               Text="Nothing transcribed yet."
               Classes="caption"
               Margin="0,12,0,0"
               IsVisible="{Binding !HasEntries}" />

    <TextBlock Grid.Row="1"
               Text="{Binding PlaybackError}"
               Classes="Error"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               IsVisible="{Binding PlaybackError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ListBox x:Name="HistoryList"
             Grid.Row="2"
             Margin="0,12,0,0"
             ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:HistoryItemViewModel">
          <Grid ColumnDefinitions="*,Auto" Margin="0,6">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Timestamp}" Classes="caption" />
                <TextBlock Text="{Binding Details}" Classes="caption" />
              </StackPanel>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Transcription}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Transcription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
              <Button Classes="Default VariantText Small"
                      Command="{Binding $parent[ListBox].((vm:HistoryViewModel)DataContext).PlayCommand}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding HasAudio}"
                      ToolTip.Tip="Play the recording">
                <Panel>
                  <PathIcon Data="{StaticResource play_regular}" IsVisible="{Binding !IsPlaying}" />
                  <PathIcon Data="{StaticResource stop_regular}" IsVisible="{Binding IsPlaying}" />
                </Panel>
              </Button>

              <Button Classes="Default VariantText Small"
                      ToolTip.Tip="Copy"
                      Click="OnCopyClicked">
                <PathIcon Data="{StaticResource copy_regular}" />
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </Grid>
</UserControl>
