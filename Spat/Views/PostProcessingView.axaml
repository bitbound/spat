<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spat.ViewModels"
             xmlns:sc="using:Spat.Libraries.Core.SpeechCommands"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="Spat.Views.PostProcessingView"
             x:DataType="vm:PostProcessingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" Margin="20,20,20,0">
      <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">

        <TextBlock Classes="h1" Text="Post-processing" />

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Sends the transcription through a text model before typing it. This helps with punctuation, capitalization, and filler words. It takes its own endpoint, key, and model, so a small local model can clean up the text while the speech endpoint stays somewhere else." />

            <CheckBox Content="Send the transcription through a text model before typing it"
                      IsChecked="{Binding PostProcessingEnabled}" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="OpenAI endpoint" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       Text="{Binding PostEndpoint}"
                       PlaceholderText="http://localhost:13305/v1" />

              <TextBlock Grid.Row="1" Classes="field" Text="API key" Margin="0,10,0,0" />
              <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                <TextBox x:Name="PostApiKeyBox"
                         Text="{Binding PostApiKey}"
                         PasswordChar="&#x25CF;"
                         PlaceholderText="sk-..." />
                <ToggleButton Grid.Column="1"
                              Classes="Icon"
                              IsChecked="{Binding #PostApiKeyBox.RevealPassword}"
                              ToolTip.Tip="Show the key"
                              Margin="4,0,0,0">
                  <Panel>
                    <PathIcon Data="{StaticResource eye_off_regular}"
                              IsVisible="{Binding !#PostApiKeyBox.RevealPassword}" />
                    <PathIcon Data="{StaticResource eye_show_regular}"
                              IsVisible="{Binding #PostApiKeyBox.RevealPassword}" />
                  </Panel>
                </ToggleButton>
              </Grid>

              <TextBlock Grid.Row="2" Classes="field" Text="Model" Margin="0,10,0,0" />
              <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding PostModels}"
                          Text="{Binding PostModelId}"
                          IsEditable="True"
                          PlaceholderText="model id" />
                <Button Grid.Column="1"
                        Classes="Primary VariantText Small"
                        Command="{Binding RefreshPostModelsCommand}"
                        IsEnabled="{Binding !IsLoadingPostModels}"
                        ToolTip.Tip="Load models from /v1/models"
                        Margin="8,0,0,0">
                  <PathIcon Data="{StaticResource arrow_sync_regular}" />
                </Button>
              </Grid>

              <TextBlock Grid.Row="3" Classes="field" Text="Timeout (seconds)" Margin="0,10,0,0" />
              <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                       Text="{Binding PostTimeoutSeconds}"
                       ToolTip.Tip="How long to wait for the text model. Raise it for slow reasoning models." />
            </Grid>

            <TextBlock Text="{Binding PostModelsMessage}" Classes="caption" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Model overrides" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Thinking" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding ThinkingModes}"
                        SelectedItem="{Binding ThinkingMode}"
                        HorizontalAlignment="Left" />

              <TextBlock Grid.Row="1" Classes="field" Text="Reasoning effort" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                        ItemsSource="{Binding ReasoningEfforts}"
                        SelectedItem="{Binding ReasoningEffort}"
                        HorizontalAlignment="Left" />

              <TextBlock Grid.Row="2" Classes="field" Text="response_format" Margin="0,8,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                        ItemsSource="{Binding ResponseFormats}"
                        SelectedItem="{Binding ResponseFormat}"
                        HorizontalAlignment="Left" />

              <TextBlock Grid.Row="3" Classes="field" Text="temperature" Margin="0,8,0,0" />
              <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Temperature}" />

              <TextBlock Grid.Row="4" Classes="field" Text="top_p" Margin="0,8,0,0" />
              <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding TopP}" />

              <TextBlock Grid.Row="5" Classes="field" Text="max_completion_tokens" Margin="0,8,0,0" />
              <TextBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="{Binding MaxCompletionTokens}" />

              <TextBlock Grid.Row="6" Classes="field" Text="max_tokens" Margin="0,8,0,0" />
              <TextBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="{Binding MaxTokens}" />

              <TextBlock Grid.Row="7" Classes="field" Text="frequency_penalty" Margin="0,8,0,0" />
              <TextBox Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Text="{Binding FrequencyPenalty}" />

              <TextBlock Grid.Row="8" Classes="field" Text="presence_penalty" Margin="0,8,0,0" />
              <TextBox Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Text="{Binding PresencePenalty}" />

              <TextBlock Grid.Row="9" Classes="field" Text="repetition_penalty" Margin="0,8,0,0" />
              <TextBox Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" Text="{Binding RepetitionPenalty}" />

              <TextBlock Grid.Row="10" Classes="field" Text="seed" Margin="0,8,0,0" />
              <TextBox Grid.Row="10" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Seed}" />

              <TextBlock Grid.Row="11" Classes="field" Text="stop" Margin="0,8,0,0" />
              <TextBox Grid.Row="11" Grid.Column="1" Margin="0,8,0,0" Text="{Binding StopSequence}" />
            </Grid>

            <TextBlock Text="Extra request parameters (raw JSON object, applied last)" Classes="field" />
            <TextBox Text="{Binding AdvancedOverridesJson}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     MaxHeight="240"
                     FontFamily="Consolas,Menlo,monospace" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Post-processing prompts" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding PromptOptions}"
                        SelectedItem="{Binding SelectedPrompt}"
                        MinWidth="240" />
              <Button Content="Create new"
                      Classes="Primary VariantOutlined"
                      Command="{Binding CreatePromptCommand}" />
              <Button Content="Duplicate"
                      Classes="Default VariantOutlined"
                      Command="{Binding DuplicatePromptCommand}" />
              <Button Content="Delete"
                      Classes="Error VariantText"
                      Command="{Binding DeletePromptCommand}"
                      IsEnabled="{Binding !IsPromptReadOnly}" />
            </StackPanel>

            <TextBox Text="{Binding PromptTitle}"
                     PlaceholderText="Prompt title"
                     IsEnabled="{Binding !IsPromptReadOnly}" />

            <TextBox Text="{Binding PromptInstructions}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="140"
                     MaxHeight="360"
                     IsEnabled="{Binding !IsPromptReadOnly}"
                     PlaceholderText="Instructions. Use ${stt_output} for the transcription, ${dictionary} for the custom dictionary block, and ${speech_commands} for the spoken commands." />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Spoken commands" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="The speaker wraps words in a command by saying its start phrase, the words, and then its end phrase. For example, &quot;quote&quot; opens a block and &quot;end quote&quot; closes it, so the words between them get wrapped in quotation marks. The model leaves both phrases out of the result. Commands apply only while post-processing runs, and their phrases are left alone when they arrive without a matching close." />

            <TextBlock Classes="field" Text="Built-in commands" />

            <ItemsControl ItemsSource="{Binding BuiltInCommands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sc:SpeechCommand">
                  <StackPanel Spacing="2" Margin="0,0,0,8">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" />
                    <TextBlock Classes="caption"
                               TextWrapping="Wrap"
                               Margin="28,0,0,0"
                               Text="{Binding Instructions}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="field" Text="Your commands" Margin="0,4,0,0" />

            <ItemsControl ItemsSource="{Binding CustomCommands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sc:SpeechCommand">
                  <StackPanel Spacing="6" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding StartPhrase}"
                               PlaceholderText="start phrase, e.g. shout" />
                      <CheckBox Grid.Column="1"
                                IsChecked="{Binding Enabled}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Off keeps the command without applying it" />
                      <Button Grid.Column="2"
                              Content="Remove"
                              Classes="Error VariantText Small"
                              Command="{Binding $parent[UserControl].((vm:PostProcessingViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>

                    <TextBox Text="{Binding EndPhrasesText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="34"
                             MaxHeight="90"
                             PlaceholderText="end phrases, one per line, e.g. end shout" />

                    <TextBox Text="{Binding Instructions}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="52"
                             MaxHeight="140"
                             PlaceholderText="what to do with the words in between, e.g. write them in upper case and remove the spaces" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add command"
                    Classes="Primary VariantOutlined"
                    HorizontalAlignment="Left"
                    Command="{Binding AddCommand}" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Commands are saved with the Save button. A command without a start phrase, an end phrase, or instructions is dropped at save." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="Footer">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save"
                Classes="Primary VariantFilled"
                Command="{Binding SaveCommand}" />

        <TextBlock Text="{Binding SaveError}"
                   Classes="Error"
                   MaxWidth="420"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding SaveMessage}"
                   Classes="Success"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>