<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spat.ViewModels"
             xmlns:cd="using:Spat.Libraries.Core.CustomDictionary"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Spat.Views.DictionaryView"
             x:DataType="vm:DictionaryViewModel">

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" Margin="20,20,20,0">
      <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">

        <TextBlock Classes="h1" Text="Custom dictionary" />

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="When the transcription contains one of these phrases, the term is typed instead. Whole words and phrases only, case-insensitive. Example: &quot;get hub&quot; becomes &quot;GitHub&quot;. Entries are applied top to bottom, and the topmost one that matches wins." />

            <ItemsControl ItemsSource="{Binding DictionaryEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="cd:CustomDictionaryEntry">
                  <Grid ColumnDefinitions="*,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                    <TextBox Text="{Binding From}"
                             PlaceholderText="what you hear, e.g. get hub" />
                    <TextBlock Grid.Column="1"
                               Text="&#x2192;"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="2"
                             Text="{Binding To}"
                             PlaceholderText="what to type, e.g. GitHub" />
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding Enabled}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Off keeps the entry without applying it" />
                    <Button Grid.Column="4"
                            Content="&#x2191;"
                            Classes="Default VariantText Small"
                            ToolTip.Tip="Move up, ahead of entries whose phrases overlap this one"
                            Command="{Binding $parent[UserControl].((vm:DictionaryViewModel)DataContext).MoveEntryUpCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="5"
                            Content="&#x2193;"
                            Classes="Default VariantText Small"
                            ToolTip.Tip="Move down, behind entries whose phrases overlap this one"
                            Command="{Binding $parent[UserControl].((vm:DictionaryViewModel)DataContext).MoveEntryDownCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="6"
                            Content="Remove"
                            Classes="Error VariantText Small"
                            Command="{Binding $parent[UserControl].((vm:DictionaryViewModel)DataContext).RemoveEntryCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add entry"
                    Classes="Primary VariantOutlined"
                    HorizontalAlignment="Left"
                    Command="{Binding AddEntryCommand}" />

            <CheckBox Content="Suggest the terms to the speech model when transcribing"
                      IsChecked="{Binding HintFirstPassEnabled}"
                      ToolTip.Tip="Sends the terms as an initial_prompt hint. Endpoints that reject the hint are retried without it." />

            <CheckBox Content="Include the entries in the post-processing prompt"
                      IsChecked="{Binding IncludeInPostProcessingEnabled}"
                      ToolTip.Tip="Only applies when post-processing is configured." />

            <TextBlock Classes="caption" Text="Entries are saved with the Save button." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="Footer">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save"
                Classes="Primary VariantFilled"
                Command="{Binding SaveCommand}" />

        <TextBlock Text="{Binding SaveError}"
                   Classes="Error"
                   MaxWidth="420"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding SaveMessage}"
                   Classes="Success"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>