<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Spat.Libraries.Native.Windows</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public key of the Bitbound code-signing cert, installed into the user's trust stores by
         BitboundCertificateTrustService. Default manifest name: <RootNamespace>.Assets.bitbound.cer -->
    <EmbeddedResource Include="Assets\bitbound.cer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spat.Libraries.Core\Spat.Libraries.Core.csproj" />
  </ItemGroup>

</Project>
